# ---- Required ---------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key            # free key: https://console.groq.com
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_db
# Any Postgres with the pgvector extension works (Neon / Supabase URLs are accepted as-is).

# ---- Security ---------------------------------------------------------------
# Long random string. If empty, a random one is generated at boot and everyone is
# logged out on every restart.   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALLOW_SIGNUP=true                         # self-registration creates an `employee`

# ---- First-run users --------------------------------------------------------
SEED_DEMO_USERS=false                     # enable only for a private demo deployment
DEMO_PASSWORD=                            # required if SEED_DEMO_USERS=true
# Configure the HR admin account; it is ensured on every startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=HR Admin

# ---- Models -----------------------------------------------------------------
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_BACKEND=fastembed               # fastembed (small, no PyTorch) | huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Notifications ----------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata                 # what "today" / "tomorrow" mean
REMINDER_INTERVAL_MINUTES=30              # due-soon / overdue reminders; 0 disables
# Optional SMTP relay (STARTTLS on port 587; for Gmail use an App Password, not your account password).

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# APP_PUBLIC_URL=                           # public app URL included in notification emails






